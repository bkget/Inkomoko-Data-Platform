# ==============================================================================
# Inkomoko Data Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env and customize values for your environment.
# All credentials are read exclusively from this file at runtime.
# No secrets are hardcoded in source code or Docker Compose defaults.
# ==============================================================================

# --- PostgreSQL (OLTP Source) ---
POSTGRES_USER=inkomoko_admin
POSTGRES_PASSWORD=a1b9j0k1l2m3
POSTGRES_DB=inkomoko_oltp
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# --- ClickHouse (OLAP Warehouse) ---
CLICKHOUSE_USER=ch_admin
CLICKHOUSE_PASSWORD=q9w8e7r6t5y4u3i2o1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000

# --- Debezium CDC Connector ---
DEBEZIUM_CONNECTOR_NAME=inkomoko-postgres-connector

# --- Grafana (Observability) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=8d7f6g5h47x9y2z
# SMTP for alert emails (optional - uses Mailpit by default)
GF_SMTP_ENABLED=true
GF_SMTP_HOST=mailpit:1025
GF_SMTP_FROM_ADDRESS=alerts@inkomoko.local
GF_SMTP_FROM_NAME=Inkomoko Data Platform
GF_SMTP_SKIP_VERIFY=true
# Alert recipient (used by Grafana contact points provisioning)
ALERT_RECIPIENT_EMAIL=bkgetmom@gmail.com
ALERT_RECIPIENT_NAME=Inkomoko Admin

# --- Airflow Webserver ---
AIRFLOW_WEB_USER=admin
AIRFLOW_WEB_PASSWORD=a9s73m8n1b
AIRFLOW_WEB_EMAIL=admin@inkomoko.local

# --- Kiva API Backfill Depth ---
KIVA_PAGES=3
KIVA_PER_PAGE=100