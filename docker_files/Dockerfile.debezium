FROM quay.io/debezium/connect:2.5

USER root

# Install the Confluent Avro Converter plugin so Debezium can serialize CDC events
# as Avro and validate them against Redpanda's Confluent-compatible schema registry.
#
# The plugin archive from Confluent Hub contains the converter JAR and all its
# runtime dependencies (avro, schema-registry-client, jackson, guava, etc.).
# We extract only the lib/ JARs into a dedicated plugin directory on the Kafka
# Connect plugin path, which Debezium scans at startup.
ARG CONFLUENT_VERSION=7.6.0

RUN microdnf install -y unzip && \
    microdnf clean all && \
    mkdir -p /kafka/connect/confluent-avro-converter && \
    curl -fsSL \
        "https://api.hub.confluent.io/api/plugins/confluentinc/kafka-connect-avro-converter/versions/${CONFLUENT_VERSION}/archive" \
        -o /tmp/avro-converter.zip && \
    # Extract only the lib/ directory which contains all runtime JARs
    unzip -j /tmp/avro-converter.zip "*/lib/*.jar" \
        -d /kafka/connect/confluent-avro-converter && \
    rm /tmp/avro-converter.zip

USER kafka
